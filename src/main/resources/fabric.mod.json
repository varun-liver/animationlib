{
  "schemaVersion": 1,
  "id": "animationlib",
  "version": "${version}",
  "name": "animationlib",
  "description": "API library for other mods to build custom animations on top of.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/animationlib/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.animationlib.client.AnimationlibDataGenerator"
    ],
    "client": [
      "com.animationlib.client.AnimationlibClient"
    ],
    "main": [
      "com.animationlib.Animationlib"
    ]
  },
  "mixins": [
    "animationlib.mixins.json",
    {
      "config": "animationlib.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
